{
	"name": "switchboard",
	"version": "0.1.8",
	"description": "Contas do Claude Code por pasta, com troca automática ao bater o limite",
	"type": "module",
	"license": "MIT",
	"bin": {
		"sb": "./dist/cli.js"
	},
	"files": [
		"dist",
		"schema.json"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsdown && bun scripts/gen-schema.ts && bun scripts/postbuild.ts",
		"check": "tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"jsonc-parser": "^3.3.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/bun": "^1.3.8",
		"citty": "^0.2.2",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3"
	}
}
